{
  "name": "my-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.27",
      "@trpc/server": "^11.18.0",
      "better-auth": "^1.6.22",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "@trpc/client": "^11.18.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @my-app/db db:push",
    "db:studio": "turbo -F @my-app/db db:studio",
    "db:generate": "turbo -F @my-app/db db:generate",
    "db:migrate": "turbo -F @my-app/db db:migrate",
    "test": "bun run --filter web test && bun run --filter server test && bun run --filter @my-app/api test"
  },
  "dependencies": {
    "@my-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.13"
}
